"cpu-srv-06":"eth2"  --  "ns-leaf-06":"swp25"

# GPU server in-band management: one single-homed NIC per server (eth17) onto
# an L2 access port in VLAN 102, four servers per leaf across ns-leaf-01..04.
# Deliberately not bonded - real deployments give in-band management a single
# onboard port.
"gpu-srv-01":"eth17"  --  "ns-leaf-01":"swp20"
"gpu-srv-02":"eth17"  --  "ns-leaf-01":"swp21"
"gpu-srv-03":"eth17"  --  "ns-leaf-01":"swp22"
"gpu-srv-04":"eth17"  --  "ns-leaf-01":"swp23"
"gpu-srv-05":"eth17"  --  "ns-leaf-02":"swp20"
