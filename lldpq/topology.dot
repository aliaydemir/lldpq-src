"gpu-srv-12":"eth17"  --  "ns-leaf-03":"swp23"
"gpu-srv-13":"eth17"  --  "ns-leaf-04":"swp20"
"gpu-srv-14":"eth17"  --  "ns-leaf-04":"swp21"
"gpu-srv-15":"eth17"  --  "ns-leaf-04":"swp22"
"gpu-srv-16":"eth17"  --  "ns-leaf-04":"swp23"

# Storage devices, dual-homed to the ns-leaf-07/08 pair but NOT bonded: two
# independent routed /31 links per device, so the host runs L3 multipath rather
# than LACP and neither leaf needs an Ethernet segment.
"storage-01":"eth1"  --  "ns-leaf-07":"swp20"
"storage-01":"eth2"  --  "ns-leaf-08":"swp20"
