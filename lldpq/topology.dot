# The firewall also plays the WAN edge for ns-leaf-01's dual-stack "edge" VRF,
# on a routed link rather than the border trunk.
"external-fw-01":"swp3"  --  "ns-leaf-01":"swp11"
# CPU servers, ESI-LAG dual-homed to the ns-leaf-05/06 pair. This is the only
# leaf pair still running EVPN multi-homing.
"cpu-srv-01":"eth1"  --  "ns-leaf-05":"swp20"
"cpu-srv-01":"eth2"  --  "ns-leaf-06":"swp20"
